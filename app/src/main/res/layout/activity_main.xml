<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- CABECERA: Título + Subtítulo + Salir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fontela Cristales"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reposición interna"
                    android:textSize="16sp"
                    android:textColor="@color/muted_text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalir"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir" />
        </LinearLayout>

        <!-- Fila de botones: Nuevo pedido / Ver registros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevoPedido"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo pedido" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRegistros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ver registros"
                app:backgroundTint="@color/primary_button"
                app:strokeColor="@color/primary_button"
                app:strokeWidth="0dp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- DATOS GENERALES -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:padding="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/panel_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos generales"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/accent_text" />

                <!-- Fecha y número de pedido en la misma fila -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <EditText
                        android:id="@+id/etFecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="dd/MM/yyyy"
                        android:textSize="22sp"
                        android:focusable="false"
                        android:inputType="date"
                        android:background="@drawable/input_background" />

                    <EditText
                        android:id="@+id/etNumeroPedido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="N° de pedido"
                        android:textSize="22sp"
                        android:inputType="number"
                        android:background="@drawable/input_background" />
                </LinearLayout>

                <!-- Responsable y Sector en dos columnas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Responsable"
                            android:textStyle="bold"
                            android:textColor="@color/muted_text" />

                        <Spinner
                            android:id="@+id/spResponsable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_background" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sector"
                            android:textStyle="bold"
                            android:textColor="@color/muted_text" />

                        <Spinner
                            android:id="@+id/spSector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_background" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tipología y Botón Agregar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipología"
                            android:textStyle="bold"
                            android:textColor="@color/muted_text" />

                        <Spinner
                            android:id="@+id/spTipologia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_background" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarItem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="16dp"
                        android:text="Agregar"
                        app:backgroundTint="@color/primary_button"
                        app:strokeColor="@color/primary_button"
                        app:strokeWidth="0dp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Material con el check DVH en la misma línea -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Material"
                            android:textStyle="bold"
                            android:textColor="@color/muted_text" />

                        <Spinner
                            android:id="@+id/spMaterial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_background" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cbDvh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ya es DVH"
                        android:textColor="@color/muted_text" />
                </LinearLayout>

                <!-- Dimensiones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <EditText
                        android:id="@+id/etAlto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="ALTO"
                        android:inputType="numberDecimal"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/input_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="X"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/muted_text" />

                    <EditText
                        android:id="@+id/etAncho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="ANCHO"
                        android:inputType="numberDecimal"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/input_background" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PROCESOS Y ORIGEN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:padding="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/panel_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Procesos por vidrio"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/accent_text" />

                <!-- Vidrios y procesos en dos columnas para reducir el alto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vidrio 1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/muted_text" />

                            <CheckBox
                                android:id="@+id/cbPulido"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pulido"
                                android:textColor="@color/muted_text" />

                            <CheckBox
                                android:id="@+id/cbTemplado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Templado"
                                android:textColor="@color/muted_text" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vidrio 2"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/muted_text" />

                            <CheckBox
                                android:id="@+id/cbPulidoCara2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pulido"
                                android:textColor="@color/muted_text" />

                            <CheckBox
                                android:id="@+id/cbTempladoCara2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Templado"
                                android:textColor="@color/muted_text" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Origen del corte -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Origen del corte"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:textColor="@color/accent_text" />

                <RadioGroup
                    android:id="@+id/rgOrigenCorte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbFloat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Cortar de Float"
                        android:textSize="20sp"
                        android:textColor="@color/muted_text" />

                    <RadioButton
                        android:id="@+id/rbLaminado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cortar de Laminado"
                        android:textSize="20sp"
                        android:textColor="@color/muted_text" />
                </RadioGroup>

                <!-- Motivo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motivo"
                    android:paddingTop="8dp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_text" />

                <EditText
                    android:id="@+id/etMotivo"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/input_background"
                    android:gravity="top"
                    android:inputType="textMultiLine" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vista previa del PDF / email -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:padding="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/panel_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vista previa"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:id="@+id/tvResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/muted_text"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones finales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewPdf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vista previa"
                app:backgroundTint="@color/primary_button"
                app:strokeColor="@color/primary_button"
                app:strokeWidth="0dp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEnviar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Guardar y enviar"
                app:backgroundTint="@color/primary_button"
                app:strokeColor="@color/primary_button"
                app:strokeWidth="0dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
